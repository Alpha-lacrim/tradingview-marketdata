# API-only configuration for an independently migrated company database.
# This file is not automatically loaded. Supply variables to the process or copy
# into .env ONLY in a fresh checkout; never overwrite existing configuration.
APPLICATION_ROLE=api
API_ENVIRONMENT=production
DATABASE_URL=postgresql://marketdata_api:REPLACE_WITH_SECRET@db.internal:5432/marketdata
API_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
API_CORS_ORIGINS=["https://dashboard.example.com"]
WEBSOCKET_ALLOWED_ORIGINS=["https://dashboard.example.com"]
DB_POOL_MIN=2
DB_POOL_MAX=10
MARKETDATA_POLL_SECONDS=1
