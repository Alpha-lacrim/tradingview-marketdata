# Safe LOCAL DEVELOPMENT defaults. Use a secret manager and strong passwords in production.
DATABASE_URL=postgresql://marketdata:marketdata@localhost:5432/marketdata
POSTGRES_PASSWORD=marketdata
POSTGRES_PORT=5432
API_PORT=8000
# API factory is always database-only. Collector/combined entry points require explicit roles.
APPLICATION_ROLE=api
COLLECTOR_STATUS_INTERVAL_SECONDS=5
COLLECTOR_STATUS_TTL_SECONDS=20
COLLECTOR_METRICS_HOST=127.0.0.1
# 0 disables the collector's standalone metrics HTTP listener.
COLLECTOR_METRICS_PORT=9000
# Compose host port; the container always listens on 9000.
COLLECTOR_METRICS_PUBLISHED_PORT=9000
REGISTRY_FILE=config/instruments.mock.json
MARKET_DATA_PROVIDER_CRYPTO=mock
MARKET_DATA_PROVIDER_FOREX=mock
MARKET_DATA_PROVIDER_METALS=mock
MARKET_DATA_PROVIDER_ENERGY=mock
MARKET_DATA_PROVIDER_FUTURES=mock
ENABLED_ASSET_CLASSES=["crypto","forex","metals","energy","futures"]
QUEUE_CAPACITY=50000
BATCH_SIZE=1000
BATCH_FLUSH_SECONDS=0.1
DB_TIMEOUT_SECONDS=10
DB_POOL_MIN=2
DB_POOL_MAX=10
# Source-only opt-in. Read docs/fastapi-v1.1-source-capture.md before isolated installation.
# Source requires base 0006 + sc0001; company destination remains 0009.
SOURCE_CAPTURE_ENABLED=false
SOURCE_CAPTURE_MAX_ROWS=1000000
SOURCE_CAPTURE_MAX_BYTES=536870912
SHUTDOWN_TIMEOUT_SECONDS=20
RECONNECT_MIN_SECONDS=1
RECONNECT_MAX_SECONDS=60
STALE_SECONDS=30
MOCK_TICKS_PER_SECOND=100
MOCK_SEED=42
WEBSOCKET_QUEUE_CAPACITY=256
WEBSOCKET_MAX_CLIENTS=1000
WEBSOCKET_MAX_SYMBOLS=500
WEBSOCKET_SEND_TIMEOUT_SECONDS=5
# Versioned WS rejects missing/unapproved Origin even with valid bearer credentials.
# The final browser authentication architecture is unknown; BFF proxy is PROVISIONAL.
WEBSOCKET_ALLOWED_ORIGINS=[]
WEBSOCKET_MAX_TOTAL_SUBSCRIPTIONS=10000
WEBSOCKET_MESSAGE_MAX_BYTES=65536
WEBSOCKET_SNAPSHOT_MAX_ROWS=1000
WEBSOCKET_SNAPSHOT_BATCH_SIZE=25
WEBSOCKET_HEARTBEAT_SECONDS=10
MARKETDATA_POLL_SECONDS=1
MARKETDATA_EVENT_BATCH_SIZE=250
# Retention is a count of journal events, not a historical candle retention policy.
MARKETDATA_EVENT_RETENTION_COUNT=100000
LOG_LEVEL=INFO
# Production API requires a strong random API_KEY (>=32 characters). Development/test may omit it.
API_ENVIRONMENT=development
# Exact origins, without paths/trailing slash. Production requires HTTPS.
API_CORS_ORIGINS=[]
API_HISTORY_MAX_DAYS=31
API_MAX_ROWS=1000
# Optional in development; required in production. Keep it server-side; use a company BFF.
# API_KEY=
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_REST_URL=https://api.binance.com
OANDA_ENVIRONMENT=practice
# OANDA_API_TOKEN=
# OANDA_ACCOUNT_ID=
# DATABENTO_API_KEY=
# Experimental guest quote collector; see docs/tradingview.md before enabling.
# REGISTRY_FILE=config/instruments.tradingview.json
# MARKET_DATA_PROVIDER_CRYPTO=tradingview_guest
# MARKET_DATA_PROVIDER_FOREX=tradingview_guest
# MARKET_DATA_PROVIDER_METALS=tradingview_guest
# MARKET_DATA_PROVIDER_ENERGY=tradingview_guest
# MARKET_DATA_PROVIDER_FUTURES=disabled
TRADINGVIEW_WS_URL=wss://data.tradingview.com/socket.io/websocket
TRADINGVIEW_STORAGE_MODE=candles
# Collector-only opt-in: dual runs native candles and independent continuous quotes.
# The delivered FastAPI v1.0 has its own environment; never pass dual to its Settings.
TRADINGVIEW_QUOTE_HISTORY=false
CANDLE_INTERVAL=1m
CANDLE_FETCH_GRACE_SECONDS=2
# Completed-minute recovery window; request allows one extra forming bar.
CANDLE_BACKFILL_MINUTES=300
# Refetch these completed minutes in the same normal minute cycle (<= backfill horizon).
CANDLE_CORRECTION_LOOKBACK_MINUTES=3
CANDLE_REQUEST_TIMEOUT_SECONDS=15
# One socket, one series per chart session. Higher windows require live evidence first.
TRADINGVIEW_CANDLE_CONCURRENCY=2
# Explicit opt-in makes the ordinary factory construct the existing pool. Counts come
# from REGISTRY_FILE, not a benchmark. See docs/production-instrument-expansion.md.
TRADINGVIEW_CANDLE_POOL_ENABLED=false
# Local ceilings, not provider-granted allowances. Each worker remains capped at 100.
CANDLE_POOL_CONNECTIONS=1
CANDLE_POOL_WORKER_CAPACITY=100
CANDLE_POOL_MAX_INSTRUMENTS=100
CANDLE_POOL_CONCURRENCY=2
# Cooperative retrieval/handshake deadline; bounded I/O cleanup follows.
CANDLE_POOL_DEADLINE_SECONDS=48
CANDLE_POOL_CLEANUP_SECONDS=3
# Fixed connection-start pacing; the pilot uses two seconds.
CANDLE_POOL_CONNECT_INTERVAL_SECONDS=0
# Host-side scaling Compose override; activate only through the guarded switch procedure.
# TRADINGVIEW_INSTRUMENT_COUNT=100
# TRADINGVIEW_SCALE_IMAGE=tradingview-app:ordinary-100
# TRADINGVIEW_SCALE_CONNECTIONS=4
# TRADINGVIEW_SCALE_CONCURRENCY=8
# TRADINGVIEW_SCALE_GRACE_SECONDS=5
# Warn when cycle body exceeds 60 - grace - margin; never overlap collection cycles.
CANDLE_CYCLE_SAFETY_MARGIN_SECONDS=10
TRADINGVIEW_FRAME_TIMEOUT_SECONDS=45
TRADINGVIEW_OBSERVATION_TIMEOUT_SECONDS=60
# Receipt freshness defaults to STALE_SECONDS. Override exact source symbols as needed.
TRADINGVIEW_SYMBOL_STALE_SECONDS={}
# Example only, calibrate against measured activity; does not declare market open/closed:
# TRADINGVIEW_SYMBOL_STALE_SECONDS={"TVC:USOIL":120,"TVC:UKOIL":120}
# Operator confirmed commercial public-site access for this installation on 2026-10-14.
# Set false to revoke production ingestion. This does not change upstream entitlements.
TRADINGVIEW_PRODUCTION_ACCESS_APPROVED=true
