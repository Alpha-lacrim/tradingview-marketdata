# Safe LOCAL DEVELOPMENT defaults. Use a secret manager and strong passwords in production.
DATABASE_URL=postgresql://marketdata:marketdata@localhost:5432/marketdata
POSTGRES_PASSWORD=marketdata
POSTGRES_PORT=5432
REGISTRY_FILE=config/instruments.mock.json
MARKET_DATA_PROVIDER_CRYPTO=mock
MARKET_DATA_PROVIDER_FOREX=mock
MARKET_DATA_PROVIDER_METALS=mock
MARKET_DATA_PROVIDER_ENERGY=mock
MARKET_DATA_PROVIDER_FUTURES=mock
ENABLED_ASSET_CLASSES=["crypto","forex","metals","energy","futures"]
QUEUE_CAPACITY=50000
BATCH_SIZE=1000
BATCH_FLUSH_SECONDS=0.1
DB_TIMEOUT_SECONDS=10
DB_POOL_MIN=2
DB_POOL_MAX=10
SHUTDOWN_TIMEOUT_SECONDS=20
RECONNECT_MIN_SECONDS=1
RECONNECT_MAX_SECONDS=60
STALE_SECONDS=30
MOCK_TICKS_PER_SECOND=100
MOCK_SEED=42
WEBSOCKET_QUEUE_CAPACITY=256
WEBSOCKET_MAX_CLIENTS=1000
WEBSOCKET_MAX_SYMBOLS=500
WEBSOCKET_SEND_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
# Optional bearer token for HTTP (except /health) and WebSocket Authorization header.
# API_KEY=
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_REST_URL=https://api.binance.com
OANDA_ENVIRONMENT=practice
# OANDA_API_TOKEN=
# OANDA_ACCOUNT_ID=
# DATABENTO_API_KEY=
# Experimental guest quote collector; see docs/tradingview.md before enabling.
# REGISTRY_FILE=config/instruments.tradingview.json
# MARKET_DATA_PROVIDER_CRYPTO=tradingview_guest
# MARKET_DATA_PROVIDER_FOREX=tradingview_guest
# MARKET_DATA_PROVIDER_METALS=tradingview_guest
# MARKET_DATA_PROVIDER_ENERGY=tradingview_guest
# MARKET_DATA_PROVIDER_FUTURES=disabled
TRADINGVIEW_WS_URL=wss://data.tradingview.com/socket.io/websocket
