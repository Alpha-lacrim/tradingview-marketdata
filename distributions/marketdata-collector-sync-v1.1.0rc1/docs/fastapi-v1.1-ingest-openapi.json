            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Ingest V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
