{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReconcileKey": {
        "additionalProperties": false,
        "properties": {
          "bucket_start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Bucket Start"
          },
          "instrument_id": {
            "format": "uuid",
            "title": "Instrument Id",
            "type": "string"
          },
          "ownership_generation": {
            "exclusiveMinimum": 0,
            "maximum": 9223372036854775807,
            "title": "Ownership Generation",
            "type": "integer"
          },
          "provider": {
            "pattern": "^[a-z][a-z0-9_]{0,99}$",
            "title": "Provider",
            "type": "string"
          },
          "source_epoch": {
            "format": "uuid",
            "title": "Source Epoch",
            "type": "string"
          },
          "stream": {
            "enum": [
              "candles",
              "quotes"
            ],
            "title": "Stream",
            "type": "string"
          }
        },
        "required": [
          "instrument_id",
          "provider",
          "stream",
          "source_epoch",
          "ownership_generation"
        ],
        "title": "ReconcileKey",
        "type": "object"
      },
      "ReconcileRequest": {
        "additionalProperties": false,
        "properties": {
          "keys": {
            "items": {
              "$ref": "#/components/schemas/ReconcileKey"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Keys",
            "type": "array"
          },
          "protocol_version": {
            "maximum": 1,
            "minimum": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "session_generation": {
            "exclusiveMinimum": 0,
            "maximum": 9223372036854775807,
            "title": "Session Generation",
            "type": "integer"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "protocol_version",
          "session_id",
          "session_generation",
          "keys"
        ],
        "title": "ReconcileRequest",
        "type": "object"
      },
      "RecoveryReceipt": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "previous_session_generation": {
            "title": "Previous Session Generation",
            "type": "integer"
          },
          "previous_session_id": {
            "format": "uuid",
            "title": "Previous Session Id",
            "type": "string"
          },
          "producer_id": {
            "format": "uuid",
            "title": "Producer Id",
            "type": "string"
          },
          "protocol_version": {
            "const": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "recovery_id": {
            "format": "uuid",
            "title": "Recovery Id",
            "type": "string"
          },
          "server_recovered_at": {
            "format": "date-time",
            "title": "Server Recovered At",
            "type": "string"
          },
          "session_generation": {
            "title": "Session Generation",
            "type": "integer"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "state": {
            "const": "committed",
            "title": "State",
            "type": "string"
          },
          "streams": {
            "items": {
              "$ref": "#/components/schemas/RecoveryStream"
            },
            "title": "Streams",
            "type": "array"
          }
        },
        "required": [
          "protocol_version",
          "producer_id",
          "recovery_id",
          "previous_session_id",
          "previous_session_generation",
          "session_id",
          "session_generation",
          "expires_at",
          "server_recovered_at",
          "state",
          "streams"
        ],
        "title": "RecoveryReceipt",
        "type": "object"
      },
      "RecoveryRequest": {
        "additionalProperties": false,
        "properties": {
          "previous_session_generation": {
            "exclusiveMinimum": 0,
            "maximum": 9223372036854775807,
            "title": "Previous Session Generation",
            "type": "integer"
          },
          "previous_session_id": {
            "format": "uuid",
            "title": "Previous Session Id",
            "type": "string"
          },
          "protocol_version": {
            "maximum": 1,
            "minimum": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "recovery_id": {
            "format": "uuid",
            "title": "Recovery Id",
            "type": "string"
          },
          "streams": {
            "items": {
              "$ref": "#/components/schemas/RecoveryStream"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Streams",
            "type": "array"
          }
        },
        "required": [
          "protocol_version",
          "recovery_id",
          "previous_session_id",
          "previous_session_generation",
          "streams"
        ],
        "title": "RecoveryRequest",
        "type": "object"
      },
      "RecoveryStream": {
        "additionalProperties": false,
        "properties": {
          "instrument_id": {
            "format": "uuid",
            "title": "Instrument Id",
            "type": "string"
          },
          "ownership_generation": {
            "exclusiveMinimum": 0.0,
            "maximum": 9.223372036854776e+18,
            "title": "Ownership Generation",
            "type": "integer"
          },
          "provider": {
            "pattern": "^[a-z][a-z0-9_]{0,99}$",
            "title": "Provider",
            "type": "string"
          },
          "source_epoch": {
            "format": "uuid",
            "title": "Source Epoch",
            "type": "string"
          },
          "stream": {
            "enum": [
              "candles",
              "quotes",
              "coverage",
              "status"
            ],
            "title": "Stream",
            "type": "string"
          }
        },
        "required": [
          "instrument_id",
          "provider",
          "stream",
          "source_epoch",
          "ownership_generation"
        ],
        "title": "RecoveryStream",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ProducerBearer": {
        "bearerFormat": "key_id.secret",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Market-data ingestion",
    "version": "1.1.0rc1"
  },
