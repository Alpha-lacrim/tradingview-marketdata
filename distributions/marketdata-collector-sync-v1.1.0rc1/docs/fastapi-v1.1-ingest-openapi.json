    "/api/ingest/v1/receipts/{batch_id}": {
      "get": {
        "operationId": "receipt_api_ingest_v1_receipts__batch_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "batch_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Batch Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Receipt Api Ingest V1 Receipts  Batch Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Receipt"
      }
    },
    "/api/ingest/v1/reconcile": {
      "post": {
        "operationId": "reconcile_state_api_ingest_v1_reconcile_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReconcileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Reconcile State Api Ingest V1 Reconcile Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "ProducerBearer": []
          }
        ],
        "summary": "Reconcile State"
      }
    },
    "/api/ingest/v1/session": {
      "post": {
        "operationId": "admit_session_api_ingest_v1_session_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Admit Session Api Ingest V1 Session Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Admit Session"
      }
    },
    "/api/ingest/v1/session/recover": {
      "post": {
        "operationId": "recover_api_ingest_v1_session_recover_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryReceipt"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Producer not authorized"
          },
          "409": {
            "description": "Session, ownership or recovery request fenced"
          },
          "413": {
            "description": "Bounded recovery request exceeded"
          },
          "422": {
            "description": "Invalid recovery request"
          },
          "429": {
            "description": "Producer request budget exhausted"
          },
          "503": {
            "description": "Retry after temporary failure"
          }
        },
        "security": [
          {
            "ProducerBearer": []
          }
        ],
        "summary": "Recover"
      }
    },
    "/api/ingest/v1/session/renew": {
      "post": {
        "operationId": "renew_session_api_ingest_v1_session_renew_post",
        "responses": {
          "200": {
            "content": {
