        "bucket_end": {
          "format": "date-time",
          "title": "Bucket End",
          "type": "string"
        },
        "open": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Open",
          "type": "string"
        },
        "high": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "High",
          "type": "string"
        },
        "low": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Low",
          "type": "string"
        },
        "close": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Close",
          "type": "string"
        },
        "volume": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source volume only; null if units are unavailable",
          "title": "Volume"
