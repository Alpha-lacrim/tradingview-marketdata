        "source_status": {
          "title": "Source Status",
          "type": "string"
        },
        "received_timestamp": {
          "format": "date-time",
          "title": "Received Timestamp",
          "type": "string"
        },
        "observations": {
          "title": "Observations",
          "type": "integer"
        },
        "expected_observations": {
          "title": "Expected Observations",
          "type": "integer"
        },
